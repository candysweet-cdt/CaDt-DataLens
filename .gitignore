node_modules/
frontend/dist/
build/bin/
build/windows/installer/tmp/
/plugins/

# Taskfile 缓存 / wails3 生成物
.task/
.wails/
*.syso

# 公开语料 eval 数据（体积大且许可各异，不入库；脚本见 scripts/eval-public-corpus.mjs）
scripts/eval-data/

# local IDE / stray builds
.idea/
/datalens.exe
Thumbs.db
.DS_Store
# Windows 快捷方式（本机相关二进制，不入库）
*.lnk
# Python 字节码缓存（运行 docs/mcp-desktop 下的脚本会生成，不带前导斜杠覆盖任意层级）
__pycache__/
*.pyc

# AI 助手本地状态：持久记忆与计划文件不入库
.cadt/
.zcode/
# .workbuddy 下只有 settings.json 入库（跨 harness 的 hook / 权限规则，必须所有会话都拿到）；
# memory/ 等本机状态继续忽略。注意父目录被忽略时子项无法用 ! 反选，所以这里用 `.workbuddy/*`。
.workbuddy/*
!.workbuddy/settings.json

# 运行中替换 exe 时重命名留下的旧映像
*.running-old*.exe

# 运行中替换 exe 时的临时备份映像（按名字单独忽略，并兜住所有 *.exe~ 变体）
/datalens.exe~
/*.exe~

# Windows 保留设备名误产物（cmd 里 `> nul` 在 Git Bash 下会落地成真文件；
# 不带前导斜杠，覆盖任意层级——npm test 在 frontend/ 下跑就落在 frontend/nul）
nul
NUL
